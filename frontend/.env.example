# URL del backend a cui punta il frontend.
# In locale: http://localhost:3000 ; in produzione: l'URL del servizio Render.
VITE_API_URL=http://localhost:3000

# Google OAuth Client ID (valore pubblico, usato dal pulsante "Login con Google").
# Deve combaciare con il GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
